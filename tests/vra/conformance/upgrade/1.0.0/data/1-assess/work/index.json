   "source_path": "detection/ScriptModule/com/example/detect/endpoint.xml",
   "container_format": "raw-xml",
   "bytes": 478,
   "warnings": [],
   "script": "var category = Server.getConfigurationElementCategoryWithPath(\"Example\");\nvar element = category.configurationElements[0];\nreturn element.getAttributeWithKey(key).value;"
  },
  {
   "source": "detection",
   "kind": "ScriptModule",
   "uuid": "a6000000-0000-4000-8000-000000000003",
   "name": "launchJobTemplate",
   "category_path": "com.example.detect",
   "source_path": "detection/ScriptModule/com/example/detect/launchJobTemplate.xml",
   "container_format": "raw-xml",
   "bytes": 598,
   "warnings": [],
   "script": "var job = JSON.parse(System.getModule(\"com.example.detect\").callRest(\"POST\", \"/api/v2/job_templates/\" + templateId + \"/launch/\", \"{}\"));\nvar state = JSON.parse(System.getModule(\"com.example.detect\").callRest(\"GET\", \"/api/v2/jobs/\" + job.id + \"/\", \"\"));\nreturn state.status;"
  },
  {
   "source": "detection",
