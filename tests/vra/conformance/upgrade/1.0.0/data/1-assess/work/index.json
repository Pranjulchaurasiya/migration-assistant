   "container_format": "raw-xml",
   "bytes": 703,
   "warnings": [],
   "script": "var prototype = RESTHostManager.createHost(\"slack\");\nprototype.url = System.getModule(\"com.example.detect\").endpoint(\"slackWebhookUrl\");\nvar host = RESTHostManager.createTransientHostFrom(prototype);\nvar request = host.createRequest(\"POST\", \"\", JSON.stringify({ channel: channel, text: text }));\nrequest.contentType = \"application/json\";\nrequest.execute();"
  },
  {
   "source": "detection",
