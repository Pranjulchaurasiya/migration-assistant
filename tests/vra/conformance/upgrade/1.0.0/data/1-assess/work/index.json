   "bytes": 699,
   "warnings": [],
   "script": "var prototype = RESTHostManager.createHost(\"detect\");\nprototype.url = System.getModule(\"com.example.detect\").endpoint(\"towerUrl\");\nvar host = RESTHostManager.createTransientHostFrom(prototype);\nvar request = host.createRequest(method, path, body);\nrequest.contentType = \"application/json\";\nreturn request.execute().contentAsString;"
  },
  {
   "source": "detection",
   "kind": "ScriptModule",
   "uuid": "a6000000-0000-4000-8000-000000000007",
   "name": "createSecurityGroup",
   "category_path": "com.example.detect",
   "source_path": "detection/ScriptModule/com/example/detect/createSecurityGroup.xml",
   "container_format": "raw-xml",
   "bytes": 742,
   "warnings": [],
   "script": "var existing = ActiveDirectory.searchExactMatch(\"UserGroup\", groupName);\nif (existing && existing.length > 0) {\n    return existing[0];\n}\nou.createUserGroup(groupName);\ngroup.setAttribute(\"description\", \"created by vRO\");\nif (group.distinguishedName.indexOf(\"OU=Managed\") < 0) {\n    System.warn(\"group outside the managed OU\");\n}\nreturn group;"
  },
  {
   "source": "detection",
   "kind": "ScriptModule",
